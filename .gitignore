# Anchored to the repo root. Unanchored, `lib/` matches at ANY depth, which silently
# swallowed all of `web/src/lib/` — including `api.ts`, the SPA's entire backend client.
# Phase 4b therefore committed an SPA that could not build from a fresh clone, and it
# went unnoticed because the files exist in the working tree. Keep the leading slash.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

