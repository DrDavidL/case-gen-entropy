# --- Stage 1: build the React SPA (ADR-020) ---
# node:22, not 20: react-router 8 declares engines.node >=22.22.0. direct-sim shipped an
# image built on node 20 for exactly this reason and it was caught only on a second pass.
FROM node:22-slim AS web-build
WORKDIR /web

# `web/package.json` declares packageManager npm@11.6.2 and package-lock.json was
# generated by it, but node:22-slim ships npm 10.x. Those two resolve optional wasm
# transitives differently -- npm 11 elides @emnapi entries npm 10 requires -- and the
# mismatch surfaces as `npm ci` failing in the image while every local check passed.
# That is precisely how direct-sim's deploy broke on 2026-07-31. Install the npm the
# lockfile was written by rather than hoping the two agree.
RUN npm i -g npm@11.6.2
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
# `build` runs gen:types first, so types.gen.ts (generated, not committed) exists here.
RUN npm run build

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ ./backend/
COPY start_backend.py .

# The built SPA, served at /app by backend/app/main.py. Deliberately not at "/" -- that
# stays the build-stamp endpoint every deploy is verified against (ADR-012).
COPY --from=web-build /web/dist ./web/dist

# Remove reload parameter from start_backend.py for production
RUN sed -i 's/reload=True/reload=False, workers=1/g' start_backend.py

# Build provenance. Declared after COPY so a changed SHA does not bust the
# dependency layer cache. Surfaced at GET / and in the frontend footer so a
# stale container is visibly stale — see backend/utils/build_info.py.
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG IMAGE_TAG=unknown
ENV GIT_SHA=${GIT_SHA} BUILD_TIME=${BUILD_TIME} IMAGE_TAG=${IMAGE_TAG}

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# Start command
CMD ["python", "start_backend.py"]